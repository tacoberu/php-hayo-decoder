{--
 - Možnosti (všech) definic typů.
 -}

Bool = True | False
Age = Int [(0 150)] -- První je typ, další jsou argumenty, v závorkách jsou pravidla.
Name = String [(0 250)]
Seznam = List Name
Person = Dict {
	name: Name [(0 100)] -- To je zajímavé. Vlastně by to pak nefungovalo, protože nemohu automaticky zkontrolovat, že příchozí Name bude vždy kratší jako toto Name
	surname: Name
	age: Age
	logined?: Bool
} [person-check] -- funkce kontrolující konzistenci celé struktury
Maybe = a -> Nothing | Just a
Either = a b -> Left a | Right b


{--
Každý typ je jakože třídou. A parametrizovaný typ je třídou, vracející třídu.
Protože v PHP jsu anonymní třídy až od PHP7, kašlem na to. Budeme to řešit funkcí. Nebo funkcí v třídě :-)

$Bool = new Type('Enum', [
	['True', 'False']
], []);
$Age = new Type('Int', [], [new Expr([0, 150])]);
$Name = new Type('String', [], [new Expr([0, 250])]);
$Seznam = new Type('List', [$Name], []);
$Person = new Type('Dict', [new StructDict([
	name => new Type($Name, [], [new Expr([0, 100])),
	surname => $Name,
	age => $Age,
	'logined?' => $Bool,
])], [new Expr('person-check')]);
$Maybe = new MetaType(['a'], 'Enum', ['Nothing', 'Just a']);
$Eigher = new MetaType(['a', 'b'], 'Enum', ['Left a', 'Right b']);
-}


{--
 - Použití typů
 -}

fn = a: Int -> a + 1

match x {
	(Age):    print x
	(Person name surname _ _): print x
}
