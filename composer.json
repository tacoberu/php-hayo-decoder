{
	"name": "tacoberu/hayo-decoder",
	"description": "Hayo scripting language decoder and parser.",
	"type": "library",
	"require": {
		"ext-json": "*",
		"php" : ">=7.4",
		"tacoberu/hayo-ast": "~0.1.5"
	},
	"authors": [
		{
			"name": "Martin Takáč",
			"email": "martin@takac.name"
		}
	],
	"autoload": {
		"classmap": ["libs/"]
	},
	"license": "MIT",
	"require-dev": {
		"tracy/tracy": "^2.4",
		"phpunit/phpunit": "^11.5",
		"slevomat/coding-standard": "^8.24",
		"phpstan/phpstan": "^2.1",
		"spaze/phpstan-disallowed-calls": "^4.6"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"phpunit": [
			"vendor/bin/phpunit"
		],
		"phpcs": [
			"vendor/bin/phpcs"
		],
		"phpcbf": [
			"vendor/bin/phpcbf"
		],
		"phpstan": [
			"vendor/bin/phpstan analyse --memory-limit=512M"
		]
	}
}
